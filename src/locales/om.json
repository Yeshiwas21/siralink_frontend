  "how_it_works": {
    "badge": "Adeemsa Hojii Salphaa",
    "title": "Akkaataa Itti Hojjetu",
    "subtitle": "Sirna sadarkaa sadarkaadhan akkaataa maamiltoonni fi hojjattoonni itti walqunnamanii fi hojii itti xumuran agarsiisu.",
    "steps": {
      "step1": {
        "title": "Puroofaayilii Keessan Uumaa",
        "desc": "Akka Maamilaatti ykn Hojjataatti galmaa'aatii dandeettii, teessoo fi muuxannoo keessaniin puroofaayilii keessan ijaaraa.",
        "extra": "Puroofaayiliin mirkanaa'e amanamummaa ni dabala, daftanii akka qacarramtanis carraa keessan fooyyessa."
      },
      "step2": {
        "title": "Hojii Maxxansaa ykn Barbaadaa",
        "desc": "Maamiltoonni gaaffii hojii maxxansu. Hojjattoonni dandeettii fi teessoo isaaniirratti hundaa'uun carraawwan dhiyaatan sakatta'u.",
        "extra": "Calalliin ammayyaa hojii sirrii ta'e daftanii akka argattaniif isin gargaara."
      },
      "step3": {
        "title": "Walqunnamaa fi Mari'adhaa",
        "desc": "Hojii jalqabuu keessan dura mari'adhaa, gatii irratti waliigalaati fi tarreeffama hojii irratti waliigalaa.",
        "extra": "Qunnamtiin ifa ta'e wal-dhabdee fi maalummaa wallaaluu hir'isa."
      },
      "step4": {
        "title": "Adeemsa Hojii",
        "desc": "Gabaasa haaraa fi hordoffii ifa ta'een hojii keessan xumuraa.",
        "extra": "Maamiltoonni yeroo kamiyyuu gabaasa sadarkaa hojii gaafachuu danda'u."
      },
      "step5": {
        "title": "Kaffaltii fi Sadarkaa Kennuu",
        "desc": "Hojiin erga xumuramee fi gama lamaaniinuu yaadni erga kenneen booda kaffaltiin eegamaa ta'e ni gadhiifama.",
        "extra": "Sadarkaan kennamu mul'achuu fi qabxii amanamummaa keessan ni fooyyessa."
      }
    },
    "features": {
      "trust": {
        "title": "Sirna Amanamummaa Duraa",
        "desc": "Nageenya, iftoomina fi amantaa gama lamaanii dabaluuf kan ijaarame."
      },
      "speed": {
        "title": "Walqunnamtii Saffisaa",
        "desc": "Hojjattoonni qophii ta'an maxxansa hojii haaraaf dafanii deebii kennu."
      },
      "security": {
        "title": "Adeemsa Hojii Eegamaa",
        "desc": "Kaffaltiin fi qunnamtiin sirnaan kan qindaa'ee fi kan eegameedha."
      }
    }
  },
